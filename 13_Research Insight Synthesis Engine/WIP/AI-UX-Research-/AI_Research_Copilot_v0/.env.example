# 复制这份文件为项目根目录下的 .env（不进 Git），改一次以后 Mac/Windows、每次新开终端都自动生效。
# 优先级：真实环境变量（export / $env: / CI secret）永远高于 .env 里的值。
# 加载逻辑见 src/ai_ux_core/config.py 的 ensure_dotenv_loaded()。

# 唯一真正被代码读取的一组配置：llm.py（Interview Probe）、research_agent.py
# （材料分析 / Theme / Judge / Questionnaire）、document_parser.py（图片 OCR /
# 音视频转写的 api_key 与 base_url）三处都从这里统一取值，不再各自读一遍。
AI_UX_LLM_API_KEY=
AI_UX_LLM_BASE_URL=https://llms.documind.bosch-app.com/v1
AI_UX_LLM_MODEL=gpt-5.4-mini
AI_UX_LLM_TIMEOUT_SECONDS=90
# Bosch Documind uses the OpenAI-compatible Chat Completions route.
AI_UX_LLM_API_STYLE=chat_completions

# 图片 OCR / 音视频转写的模型覆盖；留空则分别回退到 AI_UX_LLM_MODEL 和默认值。
AI_UX_VISION_MODEL=
AI_UX_TRANSCRIBE_MODEL=
AI_UX_AUDIO_BASE_URL=

# 本地项目数据库。项目默认路径在 data/ 下；若项目目录在 OneDrive 里会被同步，
# 需要独立路径时在这里指定。
AI_UX_DATABASE_PATH=

