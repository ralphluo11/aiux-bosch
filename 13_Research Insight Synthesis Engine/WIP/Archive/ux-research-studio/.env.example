# 工作区根目录（默认：本仓库根目录，即 003_Project Files）
WORKSPACE_ROOT=

# OpenAI 兼容 API（必填才能使用 AI 生成）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 服务监听（局域网访问请保持 0.0.0.0）
HOST=0.0.0.0
PORT=8765

# 可选：局域网访问简单令牌（URL 加 ?token=xxx）
STUDIO_ACCESS_TOKEN=

# 强制注册/登录（生产环境务必 true）
STUDIO_REQUIRE_AUTH=true
SESSION_SECRET=请换成随机长字符串

# 音视频转写（OpenAI Whisper；DeepSeek Key 不能用于转写）
# TRANSCRIBE_API_KEY=sk-openai-...
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# WHISPER_MODEL=whisper-1

# AI 引擎：openai | cursor
AI_PROVIDER=openai
CURSOR_API_KEY=
CURSOR_MODEL=composer-2
